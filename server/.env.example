# DB API Marketplace (https://developers.deutschebahn.com) — subscribe to OpenBoards and FaSta
DB_CLIENT_ID=
DB_API_KEY=
# Routing + local transport. Transitous is free for FOSS apps; self-host MOTIS under real load.
MOTIS_URL=https://api.transitous.org
# Identify yourself to Transitous, e.g. "Navi-server/0.1 (+https://github.com/you/navi)"
USER_AGENT=
PORT=8080
# Where shared trips open (the website's trip page); the trip id is appended
SHARE_URL=https://taynotfound.github.io/navi/trip/?id=
# Where / redirects to
SITE_URL=https://taynotfound.github.io/navi/
DATA_DIR=./data
RATE_PER_MIN=120
# Soft memory limit in MB for small containers (optional)
MEMORY_LIMIT_MB=
# Stop calling a DB product when fewer than this many daily calls are left
DB_QUOTA_RESERVE=150
# 1 when behind a reverse proxy, so rate limiting sees real client IPs
TRUST_PROXY=0
# "Frag Navi" assistant (optional). Only free OpenRouter models are accepted.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free,openrouter/free
ASSISTANT_DAILY_LIMIT=300
